# =====================================================================
# Aqualora — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın (yerel) veya değerleri Render > Environment'a girin (canlı).
# .env dosyasını ASLA git'e eklemeyin.
# =====================================================================

# --- Temel ---
NODE_ENV=development            # canlıda: production
STORE_MODE=preview              # preview = taslak (sipariş kapalı, Google'a kapalı) · live = satış açık
PORT=3000
PUBLIC_URL=http://localhost:3000 # canlıda: https://aqualora.shop (www'siz/www'li hangisini kullanıyorsanız)
SITE_NAME=Aqualora
VITE_SITE_NAME=Aqualora

# MongoDB Atlas bağlantısı (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/aqualora?retryWrites=true&w=majority

# En az 32 karakter rastgele: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# İlk açılışta yönetici hesabı oluşturmak için (şifre en az 12 karakter). Oluştuktan sonra şifreyi buradan silebilirsiniz.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOTIFY_EMAIL=             # yeni sipariş / düşük stok / destek talebi bildirimleri

# Boş veritabanına demo ürün yüklemek için (canlıda sadece ilk kurulumda)
SEED_DEMO_DATA=false

# --- Ödeme ---
# Virgülle: card, bank_transfer
PAYMENT_METHODS=bank_transfer
CARD_PROVIDER=iyzico            # geliştirmede ödeme simülasyonu için: test
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com   # canlı: https://api.iyzipay.com
CARD_RESERVATION_MINUTES=30     # kartla ödenmeyen sipariş stoğu kaç dk tutsun
BANK_RESERVATION_HOURS=48       # havale bekleme süresi

BANK_NAME=
BANK_ACCOUNT_HOLDER=
BANK_IBAN=

# --- Kargo ---
SHIPPING_FEE=0                  # 0 = her zaman ücretsiz
FREE_SHIPPING_THRESHOLD=0       # bu tutar üzeri ücretsiz (0 = eşik yok)
SHIPPING_CARRIER=Anlaşmalı kargo
SHIPPING_ESTIMATE=1-3 iş günü

# --- E-posta (Resend: https://resend.com — ayda 3.000 e-posta ücretsiz) ---
RESEND_API_KEY=
MAIL_FROM=Aqualora <siparis@aqualora.shop>
MAIL_REPLY_TO=

# --- Müşteri destek kanalları (chat asistanında gösterilir) ---
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=               # ülke koduyla: 905XXXXXXXXX
SUPPORT_HOURS=Hafta içi 09:00-18:00

# --- Görsel yükleme (Cloudinary — ücretsiz katman yeterli) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aqualora/urunler

# --- Diğer ---
LOW_STOCK_THRESHOLD=3
ABANDONED_CART_HOURS=24
CHAT_RETENTION_DAYS=180

# Sadece frontend AYRI bir domainde barındırılıyorsa doldurun (önerilmez). Tek serviste BOŞ bırakın.
VITE_API_BASE_URL=
